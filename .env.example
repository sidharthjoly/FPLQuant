# Copy to .env and adjust as needed. All variables are optional — sensible
# defaults are defined in src/fplquant/config.py.

# FPLQUANT_DATABASE_URL=sqlite:///./data/fplquant.db
# FPLQUANT_FPL_BASE_URL=https://fantasy.premierleague.com/api
# FPLQUANT_HTTP_TIMEOUT_SECONDS=15
# FPLQUANT_HTTP_RETRIES=3
# FPLQUANT_TRANSFERMARKT_BASE_URL=https://www.transfermarkt.com
# FPLQUANT_TRANSFERMARKT_REQUEST_DELAY_SECONDS=1.5
# Football news feeds (RSS), comma-separated. See docs/DATA_SOURCES.md.
# FPLQUANT_NEWS_FEED_URLS=https://feeds.bbci.co.uk/sport/football/rss.xml,https://www.theguardian.com/football/rss
# FPLQUANT_NEWS_ARTICLE_MAX_AGE_DAYS=21
# How sure a player match must be before a feed signal can move a projection.
# FPLQUANT_NEWS_MIN_MENTION_CONFIDENCE=0.8
# Set false to keep ingesting and displaying feed news without feeding the model.
# FPLQUANT_NEWS_FEEDS_FEED_THE_MODEL=true

# FPLQUANT_REDIS_URL=redis://localhost:6379/0
# FPLQUANT_OPTIMIZE_CACHE_TTL_SECONDS=3600
# Comma-separated, or "*" for all.
# FPLQUANT_CORS_ALLOWED_ORIGINS=https://fplquant.sidharthjoly.com,https://sidharthjoly.github.io,http://localhost:8000
