.mypy_cache/
.ruff_cache/
.pytest_cache/

# Scraped Transfermarkt data, exported for transfer to another database.
# Not committed: it is a third party's data, and the SQLite file it comes from
# is ignored for the same reason.
injuries.sql
injuries.sql.gz

# SQLite writes these while a transaction is open; they are not state worth
# tracking and they churn on every write.
*.db-journal
*.db-wal
*.db-shm

# Database backups. `*.db` above does not match these — the name ends in the
# date, not in `.db` — so without this they read as untracked cruft, and the
# deploy's `git clean -fd` tries to delete them. On the server they are written
# from inside the container and owned by root, so the deploy user cannot, and
# the whole deploy aborts on a non-zero exit. One backup taken by the procedure
# in DEPLOYMENT.md would otherwise break every deploy after it.
*.db.bak*
